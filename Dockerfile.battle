# ---------- 빌드 단계 ----------
FROM debian:bookworm-slim AS build

# 로비가 보내는 SessionGrant 를 읽어야 해서 JSON 이 필요하다.
# 18d 까지는 쓰기만 해서 손으로 만들었는데, 읽기가 생기면서 조건이 바뀌었다.
RUN apt-get update && apt-get install -y --no-install-recommends \
        g++ cmake ninja-build libboost-dev nlohmann-json3-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY battle_server/CMakeLists.txt ./CMakeLists.txt
COPY battle_server/src ./src

RUN cmake -S . -B build -G Ninja -DCMAKE_BUILD_TYPE=Release \
    && cmake --build build

# ---------- 실행 단계 ----------
FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends libstdc++6 \
    && rm -rf /var/lib/apt/lists/*

RUN useradd --system --create-home --shell /usr/sbin/nologin battle
USER battle

WORKDIR /app
COPY --from=build /src/build/battle_server ./battle_server
COPY --from=build /src/build/battle_bot ./battle_bot

ENV BATTLE_SERVER_PORT=7778
EXPOSE 7778/udp

CMD ["./battle_server"]