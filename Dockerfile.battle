# ---------- 빌드 단계 ----------
FROM debian:bookworm-slim AS build

# 로비와 달리 nlohmann-json 이 없다. 배틀 서버는 JSON 을 읽지 않고,
# 로비에 보내는 한 통만 손으로 만든다.
RUN apt-get update && apt-get install -y --no-install-recommends \
        g++ cmake ninja-build libboost-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY battle_server/CMakeLists.txt ./CMakeLists.txt
COPY battle_server/src ./src

RUN cmake -S . -B build -G Ninja -DCMAKE_BUILD_TYPE=Release \
    && cmake --build build

# ---------- 실행 단계 ----------
FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends libstdc++6 \
    && rm -rf /var/lib/apt/lists/*

RUN useradd --system --create-home --shell /usr/sbin/nologin battle
USER battle

WORKDIR /app
COPY --from=build /src/build/battle_server ./battle_server
COPY --from=build /src/build/battle_bot ./battle_bot

ENV BATTLE_SERVER_PORT=7778
EXPOSE 7778/udp

CMD ["./battle_server"]